# =============================================
# Gurukul Astrology — OCR Pipeline Environment
# =============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL Database
DATABASE_URL="postgresql://user:password@localhost:5432/gurukul_astrology"

# NextAuth.js
AUTH_SECRET="your-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Storage Provider: "local" (default) | "s3" | "r2"
STORAGE_PROVIDER=local
# Optional: override local storage root (defaults to public/uploads)
STORAGE_LOCAL_ROOT=

# S3 / Cloudflare R2 (only if STORAGE_PROVIDER=s3 or r2)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OCR Engine: "tesseract" (JavaScript/Node.js via tesseract.js)
OCR_ENGINE=tesseract

# OCR Language pack — Tesseract language codes
# eng = English, hin = Hindi, san = Sanskrit
OCR_LANGUAGE=eng+hin+san

# OCR minimum confidence threshold (0.0-1.0)
OCR_MIN_CONFIDENCE=0.70

# OCR rendering DPI (higher = better quality, slower)
OCR_DPI=300

# Worker polling interval in milliseconds (for scripts/worker.js)
WORKER_POLL_INTERVAL_MS=5000

# Node environment
NODE_ENV=development
