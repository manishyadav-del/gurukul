# =============================================================================
# Gurukul Digital Book & Vedic Astrology Platform — Production Configuration
# =============================================================================

# 1. Environment & Server
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="https://gurukul.ai"

# 2. PostgreSQL & Prisma Database
# Replace with production PostgreSQL credentials.
# Note: include connection pool parameters (?connection_limit=20&pool_timeout=20)
DATABASE_URL="postgresql://gurukul_user:STRONG_PASSWORD_HERE@localhost:5432/astrology_gurukul?connection_limit=25&pool_timeout=20"

# 3. Authentication & Security (NextAuth)
# Generate a strong 32+ character random secret: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_GENERATED_32_CHAR_SECRET"
AUTH_SECRET="REPLACE_WITH_GENERATED_32_CHAR_SECRET"
NEXTAUTH_URL="https://gurukul.ai"

# Internal Shared API Secret for Background Workers & Cron Tasks
INTERNAL_API_SECRET="REPLACE_WITH_GENERATED_INTERNAL_API_SECRET"

# 4. AI Provider & Embeddings (Optional for offline deterministic mode)
# If provided, enables Gemini text-embedding-004 and Gemini 2.5 Flash grounded interpretations
GEMINI_API_KEY=""
GOOGLE_AI_KEY=""
EMBEDDING_MODEL="text-embedding-004"

# 5. Background Processing & OCR Worker
OCR_ENGINE="tesseract"
OCR_LANGUAGE="eng+hin+san"
WORKER_POLL_INTERVAL_MS=5000

# 6. Logging & Operational Monitoring
LOG_LEVEL="INFO"
BACKUP_RETENTION_COUNT=7
