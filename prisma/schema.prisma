model KundaliniModule {
  id                String                  @id @default(uuid())
  slug              String                  @unique
  title             String
  subtitle          String?
  level             String                  @default("BEGINNER") // BEGINNER, INTERMEDIATE, THEORY
  chakraAssociation String?                 // Root, Sacral, SolarPlexus, Heart, Throat, ThirdEye, Crown, All
  chakraElement     String?                 // Earth, Water, Fire, Air, Ether, Mind, Consciousness
  bijaMantra        String?                 // LAM, VAM, RAM, YAM, HAM, OM
  historicalContext String?                 @db.Text
  practices         Json                    // Array of gentle guidance steps
  safetyGuidance    String                  @db.Text
  sourceReferences  Json?                   // Array of source citations
  order             Int                     @default(0)
  status            String                  @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  userProgress      UserKundaliniProgress[]

  @@index([level, order])
  @@map("kundalini_modules")
}

model UserKundaliniProgress {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  moduleId    String           @map("module_id")
  completed   Boolean          @default(false)
  bookmarked  Boolean          @default(false)
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      KundaliniModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@map("user_kundalini_progress")
}

