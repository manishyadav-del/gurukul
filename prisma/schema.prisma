model UserDailyGoal {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  date          String    @map("date") // YYYY-MM-DD in user timezone
  targetTopics  Int       @default(2) @map("target_topics")
  studiedTopics Int       @default(0) @map("studied_topics")
  targetPages   Int       @default(10) @map("target_pages")
  readPages     Int       @default(0) @map("read_pages")
  isCompleted   Boolean   @default(false) @map("is_completed")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("user_daily_goals")
}

model UserRecentTopic {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  topicKey   String   @map("topic_key")
  title      String
  category   String   // ASTROLOGY, KUNDALINI, LIBRARY
  url        String
  viewedAt   DateTime @default(now()) @map("viewed_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicKey])
  @@index([userId, viewedAt])
  @@map("user_recent_topics")
}

model ResearchCollection {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  title       String
  description String?        @db.Text
  tags        String[]       @default([])
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       ResearchItem[]

  @@index([userId])
  @@map("research_collections")
}

model ResearchItem {
  id             String              @id @default(uuid())
  userId         String              @map("user_id")
  collectionId   String?             @map("collection_id")
  itemType       String              @default("QUERY_ANSWER") // QUERY_ANSWER, SAVED_PASSAGE, RESEARCH_NOTE, SOURCE_COMPARISON
  title          String
  query          String?             @db.Text
  answer         String?             @db.Text
  notes          String?             @db.Text
  bookId         String?             @map("book_id")
  passageId      String?             @map("passage_id")
  chapterId      String?             @map("chapter_id")
  conceptId      String?             @map("concept_id")
  pageNumber     Int?                @map("page_number")
  citations      Json?
  comparisonData Json?               @map("comparison_data")
  metadata       Json?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection     ResearchCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  book           Book?               @relation(fields: [bookId], references: [id], onDelete: SetNull)
  passage        Passage?            @relation(fields: [passageId], references: [id], onDelete: SetNull)
  chapter        Chapter?            @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  concept        KnowledgeConcept?   @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([collectionId])
  @@index([itemType])
  @@index([conceptId])
  @@map("research_items")
}

model KnowledgeConcept {
  id                  String                      @id @default(uuid())
  slug                String                      @unique
  name                String
  sanskrit            String?
  iast                String?
  category            String                      @default("VEDIC_ASTROLOGY") // VEDIC_ASTROLOGY, KUNDALINI_SPIRITUALITY, DIGITAL_LIBRARY, PHILOSOPHY
  subCategory         String?                     // GRAHA, BHAVA, RASHI, NAKSHATRA, PANCHANG, CHAKRA, TATTVA, NADI, GRANTHI, BOOK, CHAPTER
  description         String?                     @db.Text
  summary             String?                     @db.Text
  traditionalMeaning  String?                     @db.Text
  icon                String?
  color               String?
  metadata            Json?
  status              String                      @default("APPROVED") // APPROVED, DRAFT, NEEDS_REVIEW
  confidence          Float                       @default(1.0)
  isClassical         Boolean                     @default(true)
  sourceBookId        String?                     @map("source_book_id")
  sourcePassageId     String?                     @map("source_passage_id")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  sourceBook          Book?                       @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)
  sourcePassage       Passage?                    @relation(fields: [sourcePassageId], references: [id], onDelete: SetNull)
  outgoingRelations   KnowledgeRelationship[]     @relation("SourceConcept")
  incomingRelations   KnowledgeRelationship[]     @relation("TargetConcept")
  passageReferences   PassageConceptReference[]
  researchItems       ResearchItem[]

  @@index([category])
  @@index([subCategory])
  @@index([status])
  @@index([slug])
  @@map("knowledge_concepts")
}

model KnowledgeRelationship {
  id                  String            @id @default(uuid())
  sourceConceptId     String            @map("source_concept_id")
  targetConceptId     String            @map("target_concept_id")
  relationshipType    String            @map("relationship_type") // PLANET_ASSOCIATED_WITH_RASHI, CHAKRA_ASSOCIATED_WITH_TATTVA, CONCEPT_RELATED_TO_CONCEPT, NAKSHATRA_BELONGS_TO_RASHI, PASSAGE_REFERENCES_CONCEPT, CONCEPT_REFERENCED_IN_BOOK, CONCEPT_HAS_CLASSICAL_REFERENCE, BOOK_CONTAINS_CHAPTER, CHAPTER_CONTAINS_PASSAGE
  title               String?
  description         String?           @db.Text
  tradition           String?           @default("Parashari / Classical Vedic")
  classicalSource     String?           @map("classical_source")
  sourceBookId        String?           @map("source_book_id")
  sourcePassageId     String?           @map("source_passage_id")
  confidence          Float             @default(1.0)
  status              String            @default("APPROVED") // APPROVED, AI_DISCOVERED, REJECTED, NEEDS_REVIEW
  reviewedBy          String?           @map("reviewed_by")
  reviewedAt          DateTime?         @map("reviewed_at")
  isBidirectional     Boolean           @default(false) @map("is_bidirectional")
  metadata            Json?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  sourceConcept       KnowledgeConcept  @relation("SourceConcept", fields: [sourceConceptId], references: [id], onDelete: Cascade)
  targetConcept       KnowledgeConcept  @relation("TargetConcept", fields: [targetConceptId], references: [id], onDelete: Cascade)
  sourceBook          Book?             @relation(fields: [sourceBookId], references: [id], onDelete: SetNull)
  sourcePassage       Passage?          @relation(fields: [sourcePassageId], references: [id], onDelete: SetNull)

  @@unique([sourceConceptId, targetConceptId, relationshipType])
  @@index([sourceConceptId])
  @@index([targetConceptId])
  @@index([relationshipType])
  @@index([status])
  @@map("knowledge_relationships")
}

model PassageConceptReference {
  id         String            @id @default(uuid())
  passageId  String            @map("passage_id")
  conceptId  String            @map("concept_id")
  relevance  Float             @default(1.0)
  context    String?           @db.Text
  createdAt  DateTime          @default(now()) @map("created_at")

  passage    Passage           @relation(fields: [passageId], references: [id], onDelete: Cascade)
  concept    KnowledgeConcept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([passageId, conceptId])
  @@index([passageId])
  @@index([conceptId])
  @@map("passage_concept_references")
}

model KnowledgeExtractionJob {
  id              String    @id @default(uuid())
  bookId          String?   @map("book_id")
  chapterId       String?   @map("chapter_id")
  passageId       String?   @map("passage_id")
  status          String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  method          String    @default("RULE_BASED_NLP") // RULE_BASED_NLP, AI_ASSISTED, MANUAL_SCHOLARLY
  entitiesFound   Int       @default(0) @map("entities_found")
  relationsFound  Int       @default(0) @map("relations_found")
  error           String?   @db.Text
  metadata        Json?
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")

  book            Book?     @relation(fields: [bookId], references: [id], onDelete: SetNull)
  passage         Passage?  @relation(fields: [passageId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([bookId])
  @@index([passageId])
  @@map("knowledge_extraction_jobs")
}





